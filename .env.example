# Morning Agent Configuration
# Copy this file to .env and fill in your values.

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Calendar (required for calendar server)
GOOGLE_CREDENTIALS_PATH=/absolute/path/to/agent/credentials.json
GOOGLE_SHARED_CALENDAR_ID=your-shared-calendar@group.calendar.google.com

# Slack (required for posting results)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_CHANNEL_GENERAL=C08XXXXXXXXX
SLACK_WEBHOOK_SPORTS=https://hooks.slack.com/services/XXX/XXX/XXX

# YouTube (required for sports highlights server)
YOUTUBE_API_KEY=your_youtube_api_key_here
